# ─────────────────────────────────────────────────────────────────────────────
# Нефтегазовый аналитик — конфигурация
#
# Скопируйте в .env и правьте под себя:  cp .env.example .env
# Система запускается и без .env: все значения ниже — умолчания из кода.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# Любой OpenAI-совместимый endpoint. Умолчание указывает на локальный
# llama.cpp / vLLM сервер, поэтому проект работает без ключа и без аккаунта.
#
# Хостовая модель:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=gpt-4o
#
# GigaChat — контур заказчика, данные не покидают периметр:
#   OPENAI_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
#   OPENAI_API_KEY=<access_token>
#   LLM_MODEL=GigaChat-Pro
#   ★Две особенности, которые стоит знать до развёртывания. Обе решаются
#   обвязкой; код приложения не меняется ни строкой.
#     1. Авторизация — OAuth, а не постоянный ключ: access-токен живёт около
#        получаса и выменивается на Authorization key через
#        ngw.devices.sberbank.ru:9443/api/v2/oauth. Для непрерывной работы
#        перед endpoint'ом нужен прокси, обновляющий токен. Свой писать не
#        нужно: у Сбера есть открытый gpt2giga — он переводит
#        OpenAI-совместимые вызовы в GigaChat и сам обновляет токен.
#     2. Сертификат выписан Национальным УЦ Минцифры. Без его корневого
#        сертификата в доверенном хранилище проверка TLS отвергает соединение
#        (проверено вживую). В образ он кладётся штатно, через
#        update-ca-certificates.
#
# Локальный сервер (llama.cpp):
#   llama-server -m model.gguf --host 127.0.0.1 --port 8081
OPENAI_BASE_URL=http://127.0.0.1:8081/v1
OPENAI_API_KEY=not-needed-for-local
LLM_MODEL=local
# Низкая температура намеренно: аналитику нужна воспроизводимость,
# а не разнообразие формулировок.
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=300

# ── Эмбеддинги ───────────────────────────────────────────────────────────────
# Считаются локально (fastembed/ONNX): корпус отчётов не покидает машину,
# и не нужен ещё один ключ.
# ★Модель обязана быть многоязычной: отчёты на английском, вопросы на русском.
# Качественнее, но тяжелее (~2.2 ГБ): intfloat/multilingual-e5-large
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Векторная база ───────────────────────────────────────────────────────────
# По умолчанию встроенный Qdrant пишет в каталог — отдельный сервис поднимать
# не нужно, поэтому запуск укладывается в одну команду.
# Для внешнего сервера задайте QDRANT_URL, тогда QDRANT_PATH игнорируется.
QDRANT_PATH=data/qdrant
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reports

# ── Поиск по отчётам ─────────────────────────────────────────────────────────
RAG_TOP_K=5
# Ниже этого косинуса фрагмент считается нерелевантным. Именно этот порог
# переключает агента на веб-поиск: «в корпусе ответа нет».
#
# ★Значение ЗАМЕРЕНО на корпусе EIA STEO с моделью по умолчанию:
#   профильные вопросы  0.700 … 0.819   (запрос по-русски, корпус английский)
#   посторонние         0.140 … 0.452
# Порог стоит в середине зазора шириной 0.248, со смещением в сторону полноты.
# ⚠При смене EMBEDDING_MODEL порог надо ЗАМЕРИТЬ ЗАНОВО: косинусы разных
# моделей несопоставимы, перенесённый вслепую порог либо зальёт контекст
# мусором, либо молча опустошит выдачу.
RAG_MIN_SCORE=0.55
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ── Веб-поиск ────────────────────────────────────────────────────────────────
# Библиотека ddgs — единственный из перечисленных в ТЗ вариантов без API-ключа.
WEB_RESULTS=5
WEB_REGION=ru-ru
# ★КУДА УХОДИТ ТЕКСТ ВОПРОСА. Имя библиотеки происходит от DuckDuckGo, но по
# умолчанию (режим auto) она обходит СЕМЬ сервисов и выбирает адресата в момент
# запроса. Здесь адресат задан один и назван: система, которая сдаётся как
# локальная, обязана знать, куда уезжает вопрос пользователя.
# Выбор brave — по замеру (см. neftegaz/tools/web.py, таблица трёх прогонов):
# три сервиса из пяти не вернули ничего, brave повторил результат трижды.
# Переизмерить: python scripts/probe_web_backends.py
# ⚠Значения auto, all и список через запятую отвергаются, поиск при них
# не выполняется вовсе. Неизвестное имя тоже отвергается: сама ddgs на него
# молча возвращается к auto.
WEB_BACKEND=brave

# ── Память диалога ───────────────────────────────────────────────────────────
# Где хранятся ходы разговора между вопросами:
#   sqlite — в файле CHECKPOINT_DB (умолчание): разговор переживает перезапуск,
#            работают список разговоров и поиск по ним;
#   memory — в оперативной памяти процесса: на диск не попадает ничего, но
#            вместе с этим нет ни списка разговоров, ни поиска по ним;
#   off    — памяти нет, каждый вопрос отвечается с чистого листа.
#
# ★ЭТА НАСТРОЙКА РЕШАЕТ ОДИН ВОПРОС: попадает ли переписка с аналитиком на диск.
# Переписка — данные заказчика, и решение принимает тот, кто разворачивает
# систему, а не тот, кто писал код. Обойти настройку молча нельзя: реестр
# разговоров и история поиска включены ровно при `sqlite`, а при `memory` и
# `off` интерфейс говорит, что их нет и почему.
#
# Умолчание — `sqlite`, потому что множественность разговоров и поиск по ним
# входят в поставку: с `memory` проверяющий увидел бы выключенными половину
# кнопок. Кому нельзя писать на диск — ставит `memory` одной правкой.
CONVERSATION_MEMORY=sqlite
CHECKPOINT_DB=data/conversations.sqlite
# Бюджет знаков на всю историю, попадающую в промпт. Старые ходы отбрасываются
# целиком, БЕЗ пересказа: пересказ означал бы лишний вызов модели и
# недетерминизм — два одинаковых разговора обязаны давать одинаковый промпт.
HISTORY_BUDGET_CHARS=4000
# Потолок на один ход. Без него единственный длинный ответ съедает весь бюджет
# и вытесняет остальную историю — как раз ту, к которой относится «а на год?».
HISTORY_TURN_CAP_CHARS=1200

# ── Сценарий предложения: откуда берётся эластичность ────────────────────────
# measured   — оценить на корпусе отчётов (умолчание): по квартальным рядам
#              добычи, потребления, запасов и цены из таблиц STEO;
# literature — взять числа ниже, ничего не считая.
#
# ★Измерение с откатом, а не вместо: если корпус пуст или оценка вышла
# непригодной (положительная, либо доверительный интервал накрывает ноль),
# расчёт берёт литературное число и ГОВОРИТ об этом в ответе.
ELASTICITY_SOURCE=measured

# На этих числах стоит ВЕСЬ сценарный расчёт («что будет с ценой, если добыча
# упадёт на N млн барр./сут»). Кривая спроса принята с ПОСТОЯННОЙ эластичностью
# (Q = A·P^ε), поэтому цена пересчитывается как P₁/P₀ = (1 + ΔQ/Q₀)^(1/ε).
#
# ★★В этой формуле стоит НЕ эластичность спроса, хотя выглядит она так. Формуле
# нужна эластичность РЫНОЧНОГО КЛИРИНГА: на сколько процентов должна сдвинуться
# цена, чтобы рынок поглотил сдвиг ПРЕДЛОЖЕНИЯ на процент. Между ней и
# эластичностью спроса стоит БУФЕР ЗАПАСОВ — разрыв закрывается не только
# сокращением потребления, но и расходом хранилищ, а хранилища работают как
# дополнительное предложение и гасят ценовой отклик.
#
# Измерение на корпусе: эластичность спроса −0.11, эластичность клиринга −0.31.
# Подставив первую вместо второй, расчёт завышал отклик на шок −2 млн барр./сут
# с ×1.066 до ×1.219 — это не третий знак, это другой ответ.
#
# −0.31 — ИЗМЕРЕННОЕ квартальное значение (регрессия отклика цены на сдвиг
# добычи, 9 разностей, 95% ДИ −0.71…−0.20).
DEMAND_ELASTICITY_SHORT=-0.31
# ⚠Длинный конец НЕ измерен: корпус накрывает полтора года. Взято литературное
# −0.30 для эластичности СПРОСА, и для длинного горизонта это осмысленно: за
# годы буфер запасов не работает (хранилища конечны и успевают пополниться),
# поэтому клиринг сходится к спросу.
# ★Численно короткий и длинный конец почти совпали — значит на этих данных
# горизонты НЕ РАЗЛИЧАЮТСЯ, и интерполяция между ними почти плоская. Это
# честное отражение незнания, а не свойство рынка.
DEMAND_ELASTICITY_LONG=-0.30
# Горизонты (в днях), между которыми эластичность интерполируется линейно;
# за пределами — насыщение. 90 дней это квартал, 1825 — пять лет.
ELASTICITY_SHORT_DAYS=90
ELASTICITY_LONG_DAYS=1825
# Полоса неопределённости самой эластичности, на которую РАСШИРЯЕТСЯ коридор
# прогноза: сценарий добавляет гипотезу, а гипотеза не может сузить интервал.
# ★При ELASTICITY_SOURCE=measured полоса берётся из доверительного интервала
# оценки, и это значение не используется. Оно остаётся умолчанием для
# литературного режима: −0.20 — ближний край измеренного интервала.
DEMAND_ELASTICITY_BAND=-0.20
# Мировое предложение жидких углеводородов, млн барр./сут. Умолчание — порядок,
# а не факт дня: при подключённом ряде поставщика берите значение из данных.
GLOBAL_SUPPLY_MB_D=102.0

# ── Данные ───────────────────────────────────────────────────────────────────
REPORTS_DIR=data/reports
PRICES_CSV=data/prices/brent.csv
