# Нефтегазовый аналитик — образ для запуска одной командой.
#
#   docker build -t neftegaz-analyst .
#   cp .env.example .env
#   docker run -p 127.0.0.1:8501:8501 --user "$(id -u):$(id -g)" --env-file .env \
#     -v "$PWD/data:/app/data" neftegaz-analyst
#
# .env копируется явно: в репозиторий он не входит, и без этого шага --env-file
# останавливает запуск ещё до старта контейнера.
#
# Корпус отчётов и индекс монтируются томом, а не запекаются в образ:
# данные заказчика не должны попадать в артефакт сборки, и обновление корпуса
# не должно требовать пересборки.
#
# ★АДРЕС МОДЕЛИ. Умолчание OPENAI_BASE_URL указывает на 127.0.0.1 — внутри
# контейнера это его СОБСТВЕННЫЙ петлевой интерфейс, и модель на хосте по нему
# недостижима. Из контейнера годятся: адрес хоста в сети докера
# (`http://172.17.0.1:PORT/v1`, модель обязана слушать этот адрес), внешний
# endpoint, либо запуск с `--network host` — тогда 127.0.0.1 значит то же, что
# на хосте, и умолчание работает как есть.
#
# --user обязателен, когда data/ на хосте принадлежит не uid 1000: Qdrant
# в локальном режиме открывает data/qdrant/.lock на запись и иначе падает.

FROM python:3.11-slim

# python:3.11 намеренно, не 3.13: часть научного стека (statsmodels, onnxruntime)
# распространяет колёса под 3.11 быстрее и полнее, а ТЗ требует лишь 3.10+.

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    # ★Кэш модели эмбеддингов лежит в /app/models, а НЕ в /app/data — и это
    # изменение по сравнению с прежней версией, у которого есть причина.
    #
    # Модель теперь запекается в образ (см. слой ниже), а /app/data при запуске
    # закрывается смонтированным томом хоста. Всё, что запечено под /app/data,
    # монтированием заслоняется и становится недоступно — то есть запекание
    # туда не работало бы вовсе, причём молча: модель просто скачивалась бы
    # заново, как будто её и не пекли.
    #
    # Роли переменных разные — проверено смоуком. FASTEMBED_CACHE_PATH принимает
    # саму модель (241 МБ). HF_HOME принимает служебный буфер загрузчика
    # huggingface_hub; без него буфер метит в $HOME, а под --read-only запись
    # туда запрещена, и загрузка падает с «Read-only file system» ещё до того,
    # как модель начнёт сохраняться. Буфер оставлен в томе: он нужен только
    # тогда, когда модель всё-таки качают — при смене EMBEDDING_MODEL.
    FASTEMBED_CACHE_PATH=/app/models/.fastembed \
    HF_HOME=/app/data/.hf

WORKDIR /app

# ★POPPLER — ДВИЖОК КООРДИНАТ, И БЕЗ НЕГО РАЗБОР PDF НЕ РАБОТАЕТ.
#
# PDF — предпечатный макет: в файле лежат геометрические примитивы, а тега
# «таблица» в нём нет и не предполагалось. Структуру таблицы поэтому
# восстанавливают из координат слов, и координаты даёт pdftotext -bbox-layout.
#
# Стоит отдельным слоем и ПЕРВЫМ: apt меняется реже всех остальных слоёв.
# Цена — около 5 МБ образа; питоновские движки координат стоят 57 и 64 МБ.
# Poppler к тому же вызывается отдельным процессом, поэтому его GPL не
# смешивается с кодом приложения.
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Слой зависимостей отдельно от кода: правка исходников не инвалидирует
# установку пакетов, и пересборка занимает секунды вместо минут.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# pdf2xml едет КОЛЕСОМ, а не копией исходников. Библиотека — отдельный проект
# (/opt/eidos/pdf2xml), и вторая копия её кода в этом репозитории разошлась бы
# с оригиналом на первой же правке. Колесо пересобирается командой
#     pip wheel /opt/eidos/pdf2xml -w vendor --no-deps
COPY vendor/pdf2xml-0.1.0-py3-none-any.whl ./vendor/
RUN pip install --no-cache-dir vendor/pdf2xml-0.1.0-py3-none-any.whl

# ★РАБОТАЕМ НЕ ОТ ROOT. По умолчанию контейнер запускается от суперпользователя,
# и тогда любая брешь в приложении, в Streamlit или в одной из зависимостей даёт
# root внутри контейнера — а дальше отделяет от хоста только ядро. Собственный
# непривилегированный пользователь не мешает ничему из того, что делает система:
# она пишет только в /app/data.
#
# uid 1000 задан ЯВНО, а не отдан на усмотрение системы: при монтировании
# каталога с хоста права проверяются по числовому uid, а не по имени. Если на
# хосте каталог принадлежит другому пользователю, запускать следует с
# `--user "$(id -u):$(id -g)"` — образ к этому готов, потому что /app принадлежит
# создаваемому пользователю целиком.
#
# ★ЭТОТ БЛОК СТОИТ ЗДЕСЬ, А НЕ В КОНЦЕ, И ПЕРЕЕХАЛ ОН ПО ЗАМЕРУ. Раньше он был
# последним, и `chown -R` проходил по всему уже наполненному /app. Для докера
# смена владельца — изменение файла, поэтому в новый слой уезжала ПОЛНАЯ КОПИЯ
# всего, что лежит в /app. Пока там были одни исходники, копия стоила меньше
# мегабайта. С запечённой моделью она стала стоить 253 МБ — ровно столько же,
# сколько сама модель, то есть модель хранилась в образе дважды (замерено
# `docker history`: два соседних слоя по 252 и 253 МБ).
#
# Теперь пользователь заводится, пока в /app лежат только requirements.txt и
# колесо, и всё дальнейшее пишется уже от его имени: `COPY --chown` и запись
# модели владельца не меняют, второй копии не возникает.
RUN useradd --create-home --uid 1000 analyst && chown -R analyst:analyst /app
USER analyst

# ★МОДЕЛЬ ЭМБЕДДИНГОВ ЗАПЕКАЕТСЯ В ОБРАЗ. Размен назван вслух: образ тяжелеет
# примерно на 250 МБ, зато у заказчика при первом запуске не происходит
# скачивания 241 МБ с huggingface.co.
#
# Почему выбрано именно так. Продукт продаётся как локальный и замкнутый.
# Образ, который при первом же вопросе пользователя лезет в интернет за
# моделью, этому обещанию противоречит — и противоречит в худший момент, при
# первом впечатлении. В закрытом контуре (а контур заказчика закрыт) выхода в
# интернет может не быть вовсе, и тогда без запекания система просто не
# работает: без кодировщика нет ни индекса, ни поиска.
#
# Слой стоит ДО копирования исходников намеренно: правка кода не должна
# заставлять пересобирать 250 МБ.
#
# HF_HOME на время загрузки уводится в /tmp и там же стирается — в одном слое с
# загрузкой, поэтому в образ он не попадает. Это служебный буфер загрузчика: он
# содержит второй экземпляр тех же весов и в готовом образе не нужен.
#
# ⚠Имя модели здесь ДУБЛИРУЕТ умолчание в neftegaz/config.py, потому что на
# этом шаге исходников в образе ещё нет. Дубликат сам о своём устаревании не
# сообщает, поэтому равенство двух этих строк проверяется тестом —
# tests/test_no_egress.py::test_dockerfile_baked_model_matches_config_default.
ARG EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RUN HF_HOME=/tmp/hf-scratch python -c "\
from fastembed import TextEmbedding; \
TextEmbedding(model_name='$EMBEDDING_MODEL'); \
print('модель запечена:', '$EMBEDDING_MODEL')" \
    && rm -rf /tmp/hf-scratch

COPY --chown=analyst:analyst neftegaz/ ./neftegaz/
COPY --chown=analyst:analyst ui/ ./ui/
COPY --chown=analyst:analyst scripts/ ./scripts/
COPY --chown=analyst:analyst .env.example ./

# ★НАСТРОЙКИ ИНТЕРФЕЙСА ЕДУТ В ОБРАЗ. Раньше этой строки не было, и это была
# ошибка: файл .streamlit/config.toml действовал у разработчика и не действовал
# у заказчика. В частности, не действовал `toolbarMode = "viewer"`, поэтому в
# интерфейсе, который открывает заказчик, оставалась кнопка «Deploy» — она
# ведёт в Streamlit Community Cloud, чужой публичный хостинг, и предлагает
# выложить туда приложение вместе с корпусом отчётов.
COPY --chown=analyst:analyst .streamlit/ ./.streamlit/

# Демо-транскрипты едут в образ (40 КБ). Это не противоречит правилу «данные
# заказчика не запекаются»: транскрипты — наш собственный вывод, а не корпус.
# Без них scripts/check_citations.py внутри контейнера нечего проверять, то
# есть раздел отчёта о проверяемости нельзя воспроизвести там, где он обещан.
COPY --chown=analyst:analyst demo/ ./demo/

# Каталоги данных создаются в образе, чтобы контейнер стартовал и без
# смонтированного тома — с пустой базой, о чём интерфейс честно сообщит.
# Создаются уже от имени analyst — /app принадлежит ему с того шага,
# где он был заведён (выше, сразу после установки пакетов).
RUN mkdir -p data/reports data/prices data/qdrant data/.hf

EXPOSE 8501

# ★ПРОВЕРКА ЖИВОСТИ ТРОГАЕТ ОБА УЗЛА, А НЕ ТОЛЬКО СТРАНИЦУ.
#
# Раньше здесь стоял запрос к `/_stcore/health`, и этого хватало для состояния
# «здоров». 26.08.2026 контейнер поднялся здоровым за десять секунд и не работал
# вовсе: кэш модели эмбеддингов метил в домашний каталог при файловой системе
# только для чтения. Отказ вскрылся при первом вопросе пользователя.
#
# Вопрос, осуждающий такую проверку: «что она скажет, если проверяемое откажет
# полностью?» Отвечала «здоров». Теперь `scripts/healthcheck.py` требует, чтобы
# страница отвечала И хранилище открылось И эмбеддер посчитал вектор.
#
# ★`start-period` поднят с 40 с до 5 мин, и запас взят под ХУДШИЙ старт, а не
# под обычный. В обычном модель уже лежит в образе (слой выше) и её остаётся
# загрузить в память и открыть хранилище. Худший наступает, когда заказчик
# сменил EMBEDDING_MODEL или запускается не из образа: тогда те же 241 МБ
# скачиваются заново, и до конца загрузки контейнер честно не готов.
#
# ⚠Прежние 40 секунд на таком старте объявляли бы контейнер больным всегда — а
# проверка, красная всегда, не лучше отсутствующей: она перестаёт отличать
# «сломалось» от «ещё грузится».
HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
    CMD python scripts/healthcheck.py || exit 1

# Адрес прослушивания. Стоит отдельной строкой в конце, а не в общем блоке ENV
# наверху: правка адреса не должна инвалидировать слой с установкой пакетов.
# Умолчание открыто, потому что при публикации порта (`-p 127.0.0.1:8501:8501`)
# наружу выпускает докер, а не приложение; сузить до петлевого нужно только при
# `--network host`.
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Адрес НЕ передаётся флагом. Флаг командной строки старше
# переменной окружения, поэтому `-e STREAMLIT_SERVER_ADDRESS=…` при запуске
# молча ничего не менял бы: контейнер продолжал бы слушать 0.0.0.0. Умолчание
# 0.0.0.0 обязательно для публикации порта (`-p`), а для `--network host` его
# нужно уметь сузить до петлевого — отсюда переменная вместо флага.
#
# ★Это остаётся верным и после перехода на собственный вход: scripts/run_ui.py
# специально читает переменные STREAMLIT_* сам (штатный `streamlit` получает их
# через click, а собственный вход click не поднимает — без этого моста
# переменная молча перестала бы действовать). Проверено прогоном: с
# STREAMLIT_SERVER_ADDRESS=127.0.0.1 сервер слушает 127.0.0.1, без неё — 0.0.0.0.

# ★ЗАПУСК ИДЁТ ЧЕРЕЗ СОБСТВЕННЫЙ ВХОД, А НЕ ЧЕРЕЗ `streamlit run`.
#
# Штатный запуск на каждом безголовом старте обращается к постороннему серверу
# checkip.amazonaws.com, чтобы напечатать строку «External URL» с внешним
# адресом машины. Настройками это не отключается — механизм независим от
# browser.gatherUsageStats. Для системы, которая продаётся как замкнутая, это
# недопустимо. scripts/run_ui.py поднимает тот же самый Streamlit, но лишает
# его возможности сделать этот запрос. Подробности — в шапке того файла,
# перечень всего исходящего трафика — в README, раздел «Исходящий трафик».
#
# Флаги здесь больше не нужны: порт, безголовый режим и отключение сбора
# статистики вход задаёт сам.
CMD ["python", "scripts/run_ui.py"]
