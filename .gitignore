# Секреты — никогда в репозиторий. Трекается только .env.example.
.env

# Данные и артефакты: корпус, индекс, кэш модели эмбеддингов.
# Отчёты и цены забираются скриптами, индекс строится из них — держать
# их в истории значит раздуть репозиторий гигабайтами воспроизводимого.
data/reports/*.pdf
data/qdrant/
data/.fastembed/
data/.hf/
data/prices/*.csv
# Исключение: эталонный ряд Brent едет В репозиторий (36 КБ, 1258 наблюдений).
# Причина — README обещает его в таблице исходящего трафика («не запускать
# скрипт, в репозитории лежит готовый CSV»), и без файла этот совет ведёт
# в отказ прогноза. Довод «гигабайты воспроизводимого» писан про корпус PDF
# и индекс, к 36 КБ не относится. Прочие выгрузки по-прежнему игнорируются.
!data/prices/brent.csv
# Отметка о правилах сборки индекса пишется при сборке и описывает ЭТУ машину.
# В репозитории она была бы чужой: показывала бы рассогласование там, где
# индекса ещё нет, — то есть врала бы в обе стороны.
data/index-settings.json

# Правки параметров хода, сделанные из интерфейса. Это состояние ЭТОЙ установки,
# а не конфигурация продукта: приехав в чужую копию, они молча увели бы её
# поведение от того, что написано в .env.example.
data/settings-overrides.json

# База разговоров: содержит переписку целиком. Репозиторий публичный —
# сюда она не едет ни при каких обстоятельствах.
data/*.sqlite
data/*.sqlite-*

# Отметка готовности узлов. Состояние ЭТОГО запуска и ничего больше: приехав
# в чужую копию, она объявила бы здоровой систему, где ни хранилище, ни модель
# ещё никто не трогал, — то есть повторила бы ровно ту ошибку, против которой
# заведена (см. neftegaz/health.py).
data/.readiness.json

# Письмо заказчику: уже отправлено адресату, публикации не подлежит.
ПИСЬМО-СБЕРУ.md

# Исходные материалы задания — чужой документ, не наш продукт.
0_src/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Среды разработки
.idea/
.vscode/
.DS_Store

# Рабочие следы правок: снимки демо «как было до» и резервные копии файлов.
# Полезны, пока правка идёт; в истории не нужны — она их и так хранит.
demo.before-*/
*.bak
*.bak-*

# Сгенерированный показ README/ОТЧЁТ в HTML — продукт, не рукопись.
html/

# Журнал и состояние автономки: рабочие следы процесса, а не продукт.
# Живут на диске, в публикацию не едут.
AUTOPILOT-LOG.md
AUTOPILOT-STATE.md

# Журнал точки остановки: адресован преемнику, а не читателю продукта.
# Внутри — служебный слой (кто что поручил) и отрицательные результаты.
# Решение 31.08.2026: считаем внутренним документом; ценное из него
# переносится в реестр решений, сам файл в публикацию не едет.
ПРОДОЛЖЕНИЕ.md

# Внутренний разбор устройства агента (31.08.2026) — обе части лежат в html/ и
# потому уже покрыты правилом каталога выше; отдельных строк не требуют:
#   html/УСТРОЙСТВО-АГЕНТА.html — сам документ
#   html/СОБРАННЫЕ-МАТЕРИАЛЫ.md — выписки из кода, из которых он собран
